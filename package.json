{
  "name": "my-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "playwright test --config playwright.static.config.ts",
    "test:e2e:legacy": "playwright test --config playwright.config.ts",
    "setup": "node scripts/setup.js"
  },
  "dependencies": {
    "openai": "^6.0.0",
    "zod": "^3.25.76",
    "express": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "dotenv": "^17.2.3",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.18.6",
    "concurrently": "^9.2.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
