# Vercel deployment. VITE_ACCESS_CODE is embedded in public JavaScript.
# OPENAI_API_KEY stays on the server. Use a separate OpenAI project key.
VITE_ACCESS_CODE=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini

# Legacy local Node server settings (not used by static Vercel deployment).
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Run npm run setup to create a random master code locally.
ADMIN_ACCESS_CODE=
DATA_DIR=./data
PORT=3001
APP_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Qyzylorda
# Must be true when serving over HTTPS in production.
COOKIE_SECURE=false
# Executable available on PATH, or an absolute path.
FFMPEG_PATH=ffmpeg
# Set to 1 only behind one trusted reverse proxy.
TRUST_PROXY=0
